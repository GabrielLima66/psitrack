{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron/main/**/*",
    "electron/preload/**/*",
    "electron.vite.config.*",
    "drizzle.config.ts",
    "scripts/**/*",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@main/*": ["./electron/main/*"],
      "@preload/*": ["./electron/preload/*"]
    }
  }
}
